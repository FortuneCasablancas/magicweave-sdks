{
  "name": "@magicweave/sdk",
  "version": "0.2.1",
  "description": "Magicweave game backend SDK for TypeScript, React Native and Expo",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ads/web": {
      "types": "./dist/ads/web.d.ts",
      "import": "./dist/ads/web.js",
      "require": "./dist/ads/web.cjs"
    },
    "./ads/react-native": {
      "types": "./dist/ads/react-native.d.ts",
      "import": "./dist/ads/react-native.js",
      "require": "./dist/ads/react-native.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../spec/client-openapi.snapshot.json --root-types -o src/generated/schema.ts",
    "generate:check": "openapi-typescript ../spec/client-openapi.snapshot.json --root-types -o /tmp/mw-schema-check.ts && diff -q src/generated/schema.ts /tmp/mw-schema-check.ts",
    "build": "tsup src/index.ts src/ads/web.ts src/ads/react-native.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "magicweave",
    "game",
    "backend",
    "leaderboard",
    "economy",
    "ads",
    "react-native",
    "expo"
  ],
  "peerDependencies": {
    "react-native-google-mobile-ads": "*"
  },
  "peerDependenciesMeta": {
    "react-native-google-mobile-ads": {
      "optional": true
    }
  }
}
